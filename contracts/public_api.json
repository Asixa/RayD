    "supported": "The backend implements and tests this derivative for the named variant and input domain.",
    "unsupported": "The derivative has meaningful semantics but is unavailable or not validated for this backend path.",
    "not_applicable": "The named input domain or variant has no derivative semantics."
  },
  "naming_conventions": {
    "options": "New configuration records use PascalCase <Operation>Options; existing domain records retain compatibility names until a major release.",
    "results": "Result records use PascalCase semantic nouns; plural names denote collections and AD does not change the public result type name.",
    "fields": "Fields use snake_case; identifiers end in _id or _ids and ambiguous identifier spaces carry explicit local_ or global_ prefixes."
  },
  "apis": {
    "intersect": {"category": "core", "stability": "stable", "summary": "Differentiable triangle intersection."},
    "nearest_edge_point": {"category": "core", "stability": "stable", "summary": "Nearest scene edge to a point."},
    "nearest_edge_ray": {"category": "core", "stability": "stable", "summary": "Nearest scene edge to a finite segment or half-ray."},
    "nearest_edges_topk": {"category": "core", "stability": "provisional", "summary": "Deterministic top-k point-to-edge query, k <= 16."},
    "edge_mask": {"category": "core", "stability": "provisional", "summary": "Dynamic scene-global edge activation mask."},
    "visibility": {"category": "core", "stability": "stable", "summary": "Finite segment visibility."},
    "visibility_pair": {"category": "multipath", "stability": "provisional", "summary": "Two visibility segments sharing one endpoint."},
    "visibility_edge": {"category": "multipath", "stability": "provisional", "summary": "Sampled source-to-axial-edge visibility."},
    "visibility_chain": {"category": "multipath", "stability": "provisional", "summary": "Ordered segment-chain visibility and first blocker."},
    "reflection_trace": {"category": "multipath", "stability": "stable", "summary": "Specular reflection path tracing."},
    "reflection_accumulation": {"category": "multipath", "stability": "provisional", "summary": "Reflection field and power accumulation."},
    "diffraction_direct": {"category": "multipath", "stability": "provisional", "summary": "First-order diffraction path and accumulation primitives."},
    "diffraction_chain": {"category": "multipath", "stability": "experimental", "summary": "Recursive diffraction path primitives."},
    "surfel": {"category": "surfel", "stability": "experimental", "summary": "Cross-backend surfel intersection, LOS, reflection, and alpha-transmission primitives."},
    "sdf_intersect": {"category": "core", "stability": "provisional", "summary": "Cross-backend sphere-traced intersection, LOS, and reflection for a caller-owned dense SDF grid."},
    "mixed_scene": {"category": "core", "stability": "provisional", "summary": "Cross-backend unified differentiable mesh, bounded-SDF, and surfel closest-hit, LOS, reflection, and transmission queries."},
    "reverse_ad": {"category": "core", "stability": "stable", "summary": "Fixed-winner reverse-mode derivatives."},
    "forward_ad": {"category": "core", "stability": "provisional", "summary": "Fixed-winner forward-mode derivatives where implemented."},
    "torch_compile": {"category": "experimental", "stability": "provisional", "summary": "Torch dispatcher and torch.compile integration."},
    "multi_device_replicated": {"category": "core", "stability": "provisional", "summary": "Torch-only replicated multi-device execution: Scene(devices=[...]) shards a batch across full scene replicas and merges partials on the master."}
  },
