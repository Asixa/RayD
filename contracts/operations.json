  "standalone_geometry_scope": {
    "sdf": {
      "affects": ["visibility", "reflection_trace"],
      "does_not_affect": ["transmission", "diffraction_direct", "diffraction_chain"]
    },
    "surfel": {
      "affects": ["visibility", "reflection_trace", "transmission"],
      "does_not_affect": ["diffraction_direct", "diffraction_chain"]
    }
  },
  "mixed_scene_scope": {
    "record": "docs/adr/0043-unified-mixed-geometry-scene.md",
    "geometry_order_on_exact_ties": ["mesh", "sdf_by_insertion", "surfel_scene_by_insertion", "surfel_id"],
    "global_primitive_id_space": ["mesh_faces", "sdf_grids", "surfels"],
    "sdf_broad_phase": "Each SdfGrid position, rotation, and scale define an oriented bounding box; sphere tracing is clipped to its ray interval.",
    "execution": "One resident current-stream query per non-empty specialized acceleration owner, except a caller-owned packed SdfGridBatch is one SDF query owner; device-side fixed-winner selection follows with no host read, CPU fallback, or synchronization.",
    "sdf_batching": {
      "torch_owner": "SdfGridBatch stores contiguous [G,Nx,Ny,Nz] values plus [G,3]/[G,4]/[G,3] placement rows and requires G >= 2.",
      "primal": "An untracked packed batch submits one native CUDA query launch over the G*N grid-ray lanes.",
      "ad": "A batch with VJP or JVP inputs uses the existing per-grid frozen-tape operation; only the selected logical grid contributes through MixedScene.",
      "single_grid": "SdfGrid retains its original dispatcher and CUDA launch unchanged.",
      "scope": "Closest-hit and reflection inherit batching; LOS may retain per-grid bias/query submission, transmission ignores SDF, and diffraction remains absent."
    },
    "mesh_only_fast_path": "Direct delegation to the existing Scene query with no added CUDA or OptiX launch.",
    "affects": ["intersect", "visibility", "reflection_trace", "transmission"],
    "does_not_affect": ["diffraction_direct", "diffraction_chain"],
    "transmission": "Mesh hits are opaque, SDF grids are ignored, and surfel alpha transmittance is multiplicative.",
    "ad": "Fixed-winner VJP/JVP through the selected continuous mesh, SDF, or surfel fields; selection masks and IDs are discrete."
  },
  "constants": {
    "invalid_signed_id": -1,
    "invalid_unsigned_id": 4294967295,
    "invalid_distance": "inf",
    "epsilon": {
      "default": 1e-5,
      "small": 1e-6,
      "ray": 1e-3,
      "shadow": 1e-3,
      "edge_point_probe": 1e-5,
      "vacuum_permittivity": 8.854187817e-12
    },
    "ray_flags": {
      "None": 0,
      "Geometric": 1,
      "ShadingN": 2,
      "UV": 4,
      "All": 7
    }
  },
  "numeric_policy": {
    "shared_multipath": {
      "trace_tmin": 1e-5,
      "trace_tmax_finite": 1e8,
      "ray_bias": 1e-5,
      "min_segment_length": 2e-5,
      "epc_barycentric_slack": 1e-4,
      "normalize_floor": 1e-12,
      "edge_distance_epsilon": 1e-7
    },
    "backend_profiles": {
      "drjit": {
        "ray_tmin": 1e-3,
        "shadow_tmin": 1e-3,
        "endpoint_offset": 1e-5,
        "parallel_epsilon": 1e-7,
        "watertight_triangles": false,
        "surfel_endpoint_offset": 1e-3
      },
      "torch": {
        "ray_tmin": 1e-6,
        "shadow_tmin": 1e-5,
        "endpoint_offset": 1e-5,
        "parallel_epsilon": 1e-7,
        "watertight_triangles": false,
        "surfel_endpoint_offset": 1e-3
      }
    },
    "notes": [
      "drjit scene intersect and shadow_test use ray_tmin = RayEpsilon (1e-3); torch intersect uses ray_tmin = SmallEpsilon (1e-6). Frozen legacy divergence.",
      "torch has no scene-level shadow_test; its shadow_tmin (1e-5) comes from the shared segment-visibility TraceTMin used by visibility queries.",
      "endpoint_offset is the shared segment-visibility RayBias (1e-5) on both backends.",
      "surfel_endpoint_offset (1e-3, ShadowEpsilon) is a cross-backend exception: surfel visibility offsets both segment endpoints by ShadowEpsilon rather than the 1e-5 RayBias.",
      "watertight_triangles is false everywhere: OptiX builtin triangles with flags 0, no watertight intersection exists in any backend."
    ]
  },
  "miss_sentinels": {
    "distance": "inf",
    "reflection_trace_distance": 1e8,
    "invalid_id": -1
  },
  "edge_topk_tie_break": {
    "contract": "(distance_squared, global_edge_id)",
    "implemented_in": ["shared_bvh", "torch_topk"],
    "not_implemented_in": ["drjit_optix", "drjit_native_bvh"],
    "note": "drjit paths traversal-order-dependent on exact ties; unification deferred to >=P3"
  },
  "tensor_contract": {
    "vectors": {"shape": "(..., 3)", "dtype": "float32", "layout": "row-major"},
    "indices": {"dtype": "int32", "id_space": "scene-global unless documented local"},
    "active_mask": {"dtype": "bool", "broadcast": "operation-specific"},
    "invalid": {"shape_id": -1, "prim_id": -1, "edge_id": -1, "distance": "inf"},
    "ad": "fixed-winner derivatives for discrete hit, path, and edge selection"
  },
  "result_contracts": {
    "raw_hit": {
      "fields": [
        "t", "bary_u", "bary_v", "global_prim_id", "shape_id", "local_prim_id"
      ],
      "sizeof_bytes": 24,
      "miss": {"t": "inf", "global_prim_id": -1, "shape_id": -1, "local_prim_id": -1},
      "blocker_fields": ["global_prim_id"]
    },
    "intersection": {
      "canonical_fields": [
        "t", "p", "n", "geo_n", "uv", "barycentric", "shape_id",
        "prim_id", "local_prim_id", "global_prim_id"
      ],
      "backend_fields": {
        "drjit": [
          "t", "p", "n", "geo_n", "uv", "barycentric", "shape_id",
          "prim_id", "local_prim_id", "global_prim_id"
        ],
        "torch": [
          "t", "p", "n", "geo_n", "uv", "barycentric", "shape_id",
          "prim_id", "local_prim_id", "global_prim_id"
        ]
      }
    },
    "nearest_edge_point": {
      "canonical_semantics": [
        "distance", "edge_point", "edge_t", "shape_id", "edge_id", "global_edge_id"
      ],
      "backend_fields": {
        "drjit": [
          "distance", "point", "edge_t", "edge_point", "shape_id", "edge_id",
          "global_edge_id", "is_boundary"
        ],
        "torch": [
          "distance", "edge_point", "edge_t", "shape_id", "edge_id", "global_edge_id"
        ]
      }
    },
    "nearest_edge_ray": {
      "canonical_semantics": [
        "distance", "ray_t", "point", "edge_t", "edge_point", "shape_id",
        "edge_id", "global_edge_id"
      ],
      "backend_fields": {
        "drjit": [
          "distance", "ray_t", "point", "edge_t", "edge_point", "shape_id",
          "edge_id", "global_edge_id", "is_boundary"
        ],
        "torch": [
          "distance", "ray_t", "point", "edge_t", "edge_point", "shape_id",
          "edge_id", "global_edge_id"
        ]
      }
    },
    "diffraction_states": {
      "canonical_fields": [
        "edge_index", "edge_pos", "edge_dir", "edge_t_min", "edge_t_max",
        "n0", "n1", "prim0", "prim1", "exterior_angle", "src", "src_power",
        "wi", "d0", "count"
      ],
      "backend_extensions": {"drjit": ["prefix_depth"], "torch": []},
      "complex_encoding": {"drjit": "native_complex", "torch": "real_imag_components"}
    },
    "sdf_intersection": {
      "canonical_fields": ["t", "hit_mask", "position", "normal", "steps"],
      "field_types": {
        "t": "float32[N]",
        "hit_mask": "bool[N]",
        "position": "float32[N, 3]",
        "normal": "float32[N, 3]",
        "steps": "int32[N]"
      },
      "differentiable_fields": ["t", "position", "normal"],
      "backend_fields": {
        "drjit": ["t", "hit_mask", "position", "normal", "steps"],
        "torch": ["t", "hit_mask", "position", "normal", "steps"]
      },
      "miss": {"t": "inf", "hit_mask": false, "position": 0.0, "normal": 0.0},
      "miss_inertness": "A missed lane is bitwise inert: position and normal are exact positive zero, every gradient and tangent is exact positive zero, and the lane contributes no atomic to any shared gradient buffer.",
      "non_finite_policy": "t = inf on a miss is the only non-finite value any output or derivative may carry."
    }
  },
  "shardability_classes": {
    "record": "docs/adr/0038-replicated-multi-device-execution.md",
    "classes": {
      "per_ray": "Shards along the batch axis; the gathered multi-device result is bitwise the single-device result, at any weighting and any chunk count.",
      "grid_reduce": "Shards along the Monte-Carlo lane axis; per-shard and per-chunk partial grids are summed on the master, so a merged grid equals the single-launch grid only up to float32 summation order.",
      "source_lane": "Shards whole transmitter blocks whose fixed SourceLane rows are concatenated without compaction or floating-point reduction.",
      "variant_specific": "The operation family contains variants with different shardability classes; consumers must read variant_shardability.",
      "batch_coupled": "The result depends on the whole launch rather than on each row; sharding needs an explicit per-shard contract, and until it has one a multi-device scene refuses loudly."
    },
    "torch_multi_device": {
      "sharded": "The replicated layer wraps the operation and executes it across devices.",
      "unsupported": "The operation raises NotImplementedError on a multi-device Scene instead of changing meaning.",
      "single_device": "The operation is outside the Scene surface the replicated layer wraps, so a multi-device Scene never sees it; it neither shards nor refuses.",
      "variant_specific": "Variants in this operation family have different multi-device dispositions; consumers must read variant_shardability."
    },
    "merge_order": "Per-shard and per-chunk partials are summed on the master in devices order after each device accumulated its chunks in ascending lane order; integer counters merge exactly and float fields merge in float32, so a merged result matches the single launch only up to float32 summation order. No within-launch reduction is re-associated.",
    "lane_window": {
      "parameters": ["lane_offset", "lane_count"],
      "defaults": {"lane_offset": 0, "lane_count": -1},
      "semantics": "For stochastic diffraction accumulation the lane space is direct_samples + keller_samples + suffix_samples; coherent direct accumulation uses state_count * grid_cell_count deterministic lanes. Local lane l of a launch runs global lane lane_offset + l, and lane_count < 0 means every remaining lane.",
      "invariance": "lane_offset = 0 with the default lane_count is bitwise the unwindowed single launch.",
      "partition": "Contiguous, disjoint windows covering the caller's window draw exactly the samples the single launch draws; the multiset of drawn samples is independent of the split.",
      "warp_alignment": 32,
      "warp_alignment_rule": "Grid accumulation aggregates a warp's contributions before its atomic, so merged-grid equality with a single launch is claimed only for warp-multiple windows.",
      "trace_backend": "A non-zero lane_offset requires the OptiX trace backend and is rejected on the pure-CUDA one. Replicated accumulation on the CUDA backend therefore runs the caller's complete zero-offset window once on the master; a chunking or budget request that would split it fails loudly."
    }
  },
  "operations": {
    "intersect": {
      "shardability": {"class": "per_ray", "torch_multi_device": "sharded"},
      "integration": {"drjit": ["jit_symbolic"], "torch": ["eager_native"]},
      "derivative_variants": ["intersect"],
      "inputs": ["ray", "active_mask", "ray_flags"],
      "result": "intersection",
      "id_spaces": {"shape_id": "scene-shape", "local_prim_id": "shape-local", "global_prim_id": "scene-global"},
      "ad": "fixed-winner forward/VJP/JVP for continuous geometry fields",
      "backend_overrides": {
        "drjit": {"ray_tmin": 1e-3},
        "torch": {"ray_tmin": 1e-6}
      }
    },
    "nearest_edge_point": {
      "shardability": {"class": "per_ray", "torch_multi_device": "sharded"},
      "integration": {"drjit": ["eager_native"], "torch": ["eager_native"]},
      "derivative_variants": ["nearest_edge"],
      "inputs": ["point", "active_mask"],
      "result": "nearest_edge_point",
      "id_spaces": {"edge_id": "shape-local", "global_edge_id": "scene-global"},
      "ad": "fixed-winner forward/VJP/JVP"
    },
    "nearest_edge_ray": {
      "shardability": {"class": "per_ray", "torch_multi_device": "sharded"},
      "integration": {"drjit": ["eager_native"], "torch": ["eager_native"]},
      "derivative_variants": ["nearest_edge"],
      "inputs": ["ray", "active_mask"],
      "result": "nearest_edge_ray",
      "ray_domain": "[0, tmax] when tmax is finite",
      "id_spaces": {"edge_id": "shape-local", "global_edge_id": "scene-global"},
      "ad": "fixed-winner forward/VJP/JVP"
    },
    "nearest_edges_topk": {
      "shardability": {"class": "per_ray", "torch_multi_device": "sharded"},
      "integration": {"drjit": ["eager_native"], "torch": ["eager_native"]},
      "derivative_variants": ["nearest_edges"],
