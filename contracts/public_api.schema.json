{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rayd.dev/schemas/public_api.schema.json",
  "title": "RayD public API and capability manifest",
  "type": "object",
  "required": [
    "version",
    "capability_keys",
    "stability_levels",
    "derivative_statuses",
    "naming_conventions",
    "apis",
    "aliases",
    "backends",
    "trace"
  ],
  "$defs": {
    "derivativeStatus": {
      "enum": ["supported", "unsupported", "not_applicable"]
    },
    "derivativePair": {
      "type": "object",
      "required": ["vjp", "jvp"],
      "properties": {
        "vjp": {"$ref": "#/$defs/derivativeStatus"},
        "jvp": {"$ref": "#/$defs/derivativeStatus"}
      },
      "additionalProperties": false
    },
    "derivativeVariant": {
      "type": "object",
      "required": ["primal", "input_domains"],
      "properties": {
        "primal": {"type": "boolean"},
        "input_domains": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/derivativePair"}
        },
        "note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "operationDerivatives": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {"$ref": "#/$defs/derivativeVariant"}
      }
    }
  },
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "capability_keys": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "stability_levels": {
      "type": "array",
      "items": {"enum": ["stable", "provisional", "experimental", "deprecated"]},
      "uniqueItems": true
    },
    "derivative_statuses": {
      "type": "object",
      "required": ["supported", "unsupported", "not_applicable"],
      "properties": {
        "supported": {"type": "string", "minLength": 1},
        "unsupported": {"type": "string", "minLength": 1},
        "not_applicable": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "naming_conventions": {
      "type": "object",
      "required": ["options", "results", "fields"],
      "properties": {
        "options": {"type": "string", "minLength": 1},
        "results": {"type": "string", "minLength": 1},
        "fields": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "apis": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["category", "stability"],
        "properties": {
          "category": {"enum": ["core", "multipath", "surfel", "experimental"]},
          "stability": {"enum": ["stable", "provisional", "experimental", "deprecated"]},
          "summary": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "aliases": {"type": "object"},
    "backends": {
      "type": "object",
      "required": ["drjit", "torch"],
      "additionalProperties": {
        "type": "object",
        "required": ["capabilities", "derivatives", "typing"],
        "properties": {
          "capabilities": {"type": "object", "additionalProperties": {"type": "boolean"}},
          "derivatives": {"$ref": "#/$defs/operationDerivatives"},
          "typing": {"enum": ["none", "partial", "complete"]}
        },
        "additionalProperties": false
      }
    },
    "trace": {
      "type": "object",
      "required": ["backends", "integration_modes", "frontend_support"],
      "properties": {
        "backends": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["stability", "summary"],
            "properties": {
              "stability": {"enum": ["stable", "provisional", "experimental", "deprecated"]},
              "summary": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "integration_modes": {
          "type": "array",
          "items": {"enum": ["jit_symbolic", "eager_native"]},
          "uniqueItems": true
        },
        "frontend_support": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {"enum": ["jit_symbolic", "eager_native"]},
              "uniqueItems": true
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
