{
  "version": 1,
  "record": "docs/adr/0035-cuda-compile-flag-policy.md",
  "scope": {
    "records": [
      "the nvcc numeric flags every RayD CUDA translation unit is compiled with",
      "the virtual architecture of every ray-tracing PTX module",
      "which shared device-math headers are compiled under more than one numeric profile",
      "which of those divergences are frozen by decision rather than accidental"
    ],
    "excludes": [
      "epsilon and sentinel constants, which shared/include/rayd/shared/rt/numeric_policy.h owns",
      "host compiler flags, optimization level, and warning flags, which change no device arithmetic",
      "include directories, preprocessor definitions, -std, --extended-lambda, and -Xcompiler=-fPIC",
      "the effective command line after CMake resolves build-type and CUDA-language defaults; this contract records flags as written in CMake"
    ]
  },
  "profiles": {
    "nvcc_default": {
      "flags": [],
      "semantics": [
        "ftz=false",
        "prec-div=true",
        "prec-sqrt=true",
        "fmad=true",
        "IEEE division and square root, correctly rounded"
      ],
      "note": "nvcc target defaults. The absence of a flag is the policy, so a translation unit silently inherits any flag later added target-wide."
    },
    "fast_math": {
      "flags": ["--use_fast_math"],
      "semantics": [
        "ftz=true",
        "prec-div=false",
        "prec-sqrt=false",
        "fmad=true",
        "approximate transcendentals and reciprocals",
        "denormal inputs and results flushed to zero"
      ],
      "note": "Changes the value of division, square root, reciprocal, and every transcendental in the whole translation unit, including shared headers it pulls in."
    },
    "no_fmad": {
      "flags": ["--fmad=false"],
      "semantics": [
        "ftz=false",
        "prec-div=true",
        "prec-sqrt=true",
        "fmad=false",
        "no multiply-add contraction, so a*b+c rounds twice"
      ],
      "note": "ADR-0026 imported this from Channel to keep lockstep and AD translation units bitwise reproducible against their former owner."
    },
    "precise_no_ftz": {
      "flags": ["--ftz=false", "--prec-div=true", "--prec-sqrt=true"],
      "semantics": [
        "ftz=false",
        "prec-div=true",
        "prec-sqrt=true",
        "fmad=true",
        "identical arithmetic to nvcc_default"
      ],
      "note": "These three flags equal nvcc's own defaults. ADR-0033 spells them out so the penetration family cannot inherit a fast-math option added elsewhere; they exist to defend the family, not to change its arithmetic."
    }
  },
