{
  "version": 4,
  "required_capability_keys": [
    "backend", "intersect", "nearest_edge_point", "nearest_edge_ray",
    "nearest_edges_topk", "edge_mask", "visibility", "visibility_pair",
    "visibility_edge", "visibility_chain",
    "reflection_trace", "reflection_accumulation", "diffraction_direct",
    "diffraction_chain", "surfel", "sdf_intersect",
    "reverse_ad", "forward_ad", "torch_compile"
  ],
  "constants": {
    "invalid_signed_id": -1,
    "invalid_unsigned_id": 4294967295,
    "invalid_distance": "inf",
    "epsilon": {
      "default": 1e-5,
      "small": 1e-6,
      "ray": 1e-3,
      "shadow": 1e-3,
      "edge_point_probe": 1e-5,
      "vacuum_permittivity": 8.854187817e-12
    },
    "ray_flags": {
      "None": 0,
      "Geometric": 1,
      "ShadingN": 2,
      "UV": 4,
      "All": 7
    }
  },
  "numeric_policy": {
    "shared_multipath": {
      "trace_tmin": 1e-5,
      "trace_tmax_finite": 1e8,
      "ray_bias": 1e-5,
      "min_segment_length": 2e-5,
      "epc_barycentric_slack": 1e-4,
      "normalize_floor": 1e-12,
      "edge_distance_epsilon": 1e-7
    },
    "backend_profiles": {
      "drjit": {
        "ray_tmin": 1e-3,
        "shadow_tmin": 1e-3,
        "endpoint_offset": 1e-5,
        "parallel_epsilon": 1e-7,
        "watertight_triangles": false,
        "surfel_endpoint_offset": 1e-3
      },
      "torch": {
        "ray_tmin": 1e-6,
        "shadow_tmin": 1e-5,
        "endpoint_offset": 1e-5,
        "parallel_epsilon": 1e-7,
        "watertight_triangles": false
      }
    },
    "notes": [
      "drjit scene intersect and shadow_test use ray_tmin = RayEpsilon (1e-3); torch intersect uses ray_tmin = SmallEpsilon (1e-6). Frozen legacy divergence.",
      "torch has no scene-level shadow_test; its shadow_tmin (1e-5) comes from the shared segment-visibility TraceTMin used by visibility queries.",
      "endpoint_offset is the shared segment-visibility RayBias (1e-5) on both backends.",
      "surfel_endpoint_offset (1e-3, ShadowEpsilon) is a drjit-only exception: surfel visibility offsets both segment endpoints by ShadowEpsilon rather than the 1e-5 RayBias.",
      "watertight_triangles is false everywhere: OptiX builtin triangles with flags 0, no watertight intersection exists in any backend."
    ]
  },
  "miss_sentinels": {
    "distance": "inf",
    "reflection_trace_distance": 1e8,
    "invalid_id": -1
  },
  "edge_topk_tie_break": {
    "contract": "(distance_squared, global_edge_id)",
    "implemented_in": ["shared_bvh", "torch_topk"],
    "not_implemented_in": ["drjit_optix", "drjit_native_bvh"],
    "note": "drjit paths traversal-order-dependent on exact ties; unification deferred to >=P3"
  },
  "tensor_contract": {
    "vectors": {"shape": "(..., 3)", "dtype": "float32", "layout": "row-major"},
    "indices": {"dtype": "int32", "id_space": "scene-global unless documented local"},
    "active_mask": {"dtype": "bool", "broadcast": "operation-specific"},
    "invalid": {"shape_id": -1, "prim_id": -1, "edge_id": -1, "distance": "inf"},
    "ad": "fixed-winner derivatives for discrete hit, path, and edge selection"
  },
  "result_contracts": {
    "raw_hit": {
      "fields": [
        "t", "bary_u", "bary_v", "global_prim_id", "shape_id", "local_prim_id"
      ],
      "sizeof_bytes": 24,
      "miss": {"t": "inf", "global_prim_id": -1, "shape_id": -1, "local_prim_id": -1},
      "blocker_fields": ["global_prim_id"]
    },
    "intersection": {
      "canonical_fields": [
        "t", "p", "n", "geo_n", "uv", "barycentric", "shape_id",
        "prim_id", "local_prim_id", "global_prim_id"
      ],
      "backend_fields": {
        "drjit": [
          "t", "p", "n", "geo_n", "uv", "barycentric", "shape_id",
          "prim_id", "local_prim_id", "global_prim_id"
        ],
        "torch": [
          "t", "p", "n", "geo_n", "uv", "barycentric", "shape_id",
          "prim_id", "local_prim_id", "global_prim_id"
        ]
      }
    },
    "nearest_edge_point": {
      "canonical_semantics": [
        "distance", "edge_point", "edge_t", "shape_id", "edge_id", "global_edge_id"
      ],
      "backend_fields": {
        "drjit": [
          "distance", "point", "edge_t", "edge_point", "shape_id", "edge_id",
          "global_edge_id", "is_boundary"
        ],
        "torch": [
          "distance", "edge_point", "edge_t", "shape_id", "edge_id", "global_edge_id"
        ]
      }
    },
    "nearest_edge_ray": {
      "canonical_semantics": [
        "distance", "ray_t", "point", "edge_t", "edge_point", "shape_id",
        "edge_id", "global_edge_id"
      ],
      "backend_fields": {
        "drjit": [
          "distance", "ray_t", "point", "edge_t", "edge_point", "shape_id",
          "edge_id", "global_edge_id", "is_boundary"
        ],
        "torch": [
          "distance", "ray_t", "point", "edge_t", "edge_point", "shape_id",
          "edge_id", "global_edge_id"
        ]
      }
    },
    "diffraction_states": {
      "canonical_fields": [
        "edge_index", "edge_pos", "edge_dir", "edge_t_min", "edge_t_max",
        "n0", "n1", "prim0", "prim1", "exterior_angle", "src", "src_power",
        "wi", "d0", "count"
      ],
      "backend_extensions": {"drjit": ["prefix_depth"], "torch": []},
      "complex_encoding": {"drjit": "native_complex", "torch": "real_imag_components"}
    },
    "sdf_intersection": {
      "canonical_fields": ["t", "hit_mask", "position", "normal", "steps"],
      "field_types": {
        "t": "float32[N]",
        "hit_mask": "bool[N]",
        "position": "float32[N, 3]",
        "normal": "float32[N, 3]",
        "steps": "int32[N]"
      },
      "differentiable_fields": ["t", "position", "normal"],
      "backend_fields": {
        "drjit": [],
        "torch": ["t", "hit_mask", "position", "normal", "steps"]
      },
      "miss": {"t": "inf", "hit_mask": false, "position": 0.0, "normal": 0.0},
      "miss_inertness": "A missed lane is bitwise inert: position and normal are exact positive zero, every gradient and tangent is exact positive zero, and the lane contributes no atomic to any shared gradient buffer.",
      "non_finite_policy": "t = inf on a miss is the only non-finite value any output or derivative may carry."
    }
  },
  "operations": {
    "intersect": {
      "integration": {"drjit": ["jit_symbolic"], "torch": ["eager_native"]},
      "inputs": ["ray", "active_mask", "ray_flags"],
      "result": "intersection",
      "id_spaces": {"shape_id": "scene-shape", "local_prim_id": "shape-local", "global_prim_id": "scene-global"},
      "ad": "fixed-winner forward/VJP/JVP for continuous geometry fields",
      "backend_overrides": {
        "drjit": {"ray_tmin": 1e-3},
        "torch": {"ray_tmin": 1e-6}
      }
    },
    "nearest_edge_point": {
      "integration": {"drjit": ["eager_native"], "torch": ["eager_native"]},
      "inputs": ["point", "active_mask"],
      "result": "nearest_edge_point",
      "id_spaces": {"edge_id": "shape-local", "global_edge_id": "scene-global"},
      "ad": "fixed-winner forward/VJP/JVP"
    },
    "nearest_edge_ray": {
      "integration": {"drjit": ["eager_native"], "torch": ["eager_native"]},
      "inputs": ["ray", "active_mask"],
      "result": "nearest_edge_ray",
      "ray_domain": "[0, tmax] when tmax is finite",
      "id_spaces": {"edge_id": "shape-local", "global_edge_id": "scene-global"},
      "ad": "fixed-winner forward/VJP/JVP"
    },
    "nearest_edges_topk": {
      "integration": {"drjit": ["eager_native"], "torch": ["eager_native"]},
      "inputs": ["point", "k", "active_mask", "edge_mask"],
      "result": "nearest_edge_point[k]",
      "limits": {"min_k": 1, "max_k": 16},
      "ordering": "ascending distance, deterministic global_edge_id tie break",
      "ad": "fixed-winner forward/VJP/JVP"
    },
    "visibility": {
      "integration": {"drjit": ["jit_symbolic", "eager_native"], "torch": ["eager_native"]},
      "inputs": ["start", "end", "active_mask"],
      "result": "bool",
      "ray_domain": "finite segment with endpoint offsets",
      "ad": "discrete result; no geometry derivative"
    },
    "visibility_pair": {
      "integration": {"drjit": ["jit_symbolic", "eager_native"], "torch": ["eager_native"]},
      "inputs": ["start", "end_a", "end_b", "active_mask"],
      "result": "bool_pair",
      "ray_domain": "two finite segments with endpoint offsets",
      "ad": "discrete result; no geometry derivative"
    },
    "visibility_edge": {
      "integration": {"drjit": ["jit_symbolic", "eager_native"], "torch": ["eager_native"]},
      "inputs": ["source", "edge_position", "edge_direction", "edge_t_min", "edge_t_max", "sample_fractions", "active_mask"],
      "result": "bool",
      "limits": {"min_samples": 1, "max_samples": 16},
      "ad": "discrete result; no geometry derivative"
    },
    "visibility_chain": {
      "integration": {"drjit": ["jit_symbolic", "eager_native"], "torch": ["eager_native"]},
      "inputs": ["points", "chain_length", "ignore_prim_per_segment", "active_mask"],
      "result": "chain_visibility_and_first_blocker",
      "id_space": "scene-global primitive IDs",
      "ad": "discrete result; no geometry derivative"
    },
    "reflection_trace": {
      "integration": {"drjit": ["jit_symbolic", "eager_native"], "torch": ["eager_native"]},
      "inputs": ["source", "receiver", "max_depth", "active_mask"],
      "result": "reflection_chain",
      "id_space": "scene-global primitive IDs",
      "ad": "fixed-path forward/VJP/JVP"
    },
    "reflection_accumulation": {
      "integration": {"drjit": ["eager_native"], "torch": ["eager_native"]},
      "inputs": ["reflection_chain", "material", "frequency"],
      "result": "complex_field_and_power",
      "ad": "fixed-path forward/VJP/JVP"
    },
    "diffraction_direct": {
      "integration": {"drjit": ["eager_native"], "torch": ["eager_native"]},
      "inputs": ["diffraction_states", "material", "grid", "frequency"],
      "result": "diffraction_accumulation",
      "ad": "fixed-path forward/VJP/JVP"
    },
    "diffraction_chain": {
      "integration": {"drjit": ["eager_native"], "torch": ["eager_native"]},
      "inputs": ["diffraction_states", "material", "grid", "frequency", "max_depth"],
      "result": "diffraction_paths_or_accumulation",
      "ad": "fixed-path forward/VJP/JVP"
    },
    "sdf_intersect": {
      "record": "docs/adr/0037-differentiable-sdf-intersection.md",
      "integration": {"drjit": [], "torch": ["eager_native"]},
      "inputs": [
        "values", "position", "rotation", "scale", "origins", "directions",
        "tmax", "max_steps", "relaxation", "eps_hit"
      ],
      "result": "sdf_intersection",
      "representation": {
        "values": "vertex-centered trilinear samples, shape [Nx, Ny, Nz] with N_i >= 2, world-metric distance, negative inside",
        "placement": "oriented box from world-centre position, scalar-first unit quaternion rotation, and full side lengths scale",
        "grid_coordinate": "u_i = (x_l_i / scale_i + 0.5) * (N_i - 1) after x_l = R^T (x_w - position)"
      },
      "ray_domain": "slab overlap of the ray with the oriented box clipped to tmax; an origin inside the box starts at t_lo = 0",
      "ad": "fixed-winner forward/VJP/JVP by the implicit function theorem at the frozen hit, for values, position, rotation, scale, origins, and directions",
      "numeric_policy": {
        "relaxation_default": 0.9,
        "max_steps_default": 64,
        "bisection_steps": 32,
        "eps_hit_voxel_fraction": 1e-3,
        "eps_hit_default": "eps_hit_voxel_fraction * min_i(scale_i / (N_i - 1)), derived on the device without any host read",
        "eps_graze": 1e-6,
        "eps_norm": 1e-12,
        "eps_parallel": 1e-7,
        "grazing_clamp": "g_clamped = sign(g) * max(|g|, eps_graze) with sign(0) := +1, where g = grad_w D . wh",
        "miss_sentinel": "inf",
        "determinism": "the forward pass is bitwise deterministic and atomic-free; the values, position, rotation, and scale gradients accumulate across rays with float32 atomics"
      }
    }
  },
  "tolerances": {
    "default_abs": 1e-5, "default_rel": 1e-5,
    "field_abs": 5e-5, "field_rel": 5e-5,
    "gradient_abs": 5e-4, "gradient_rel": 5e-4
  }
}
